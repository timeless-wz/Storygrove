# 依赖
node_modules

# 构建输出
dist
dist-electron
release
# Vditor 的本地运行时资源必须随包发布；上面的 dist 规则会按目录名误伤它。
!public/vditor/dist/

# 日志
logs
*.log
npm-debug.log*
pnpm-debug.log*

# 编辑器
.vscode/*
!.vscode/extensions.json
.idea
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# 系统文件
.DS_Store
Thumbs.db

# 环境变量
.env
.env.local
.env.*.local

# 临时文件
*.local
dist-ssr
tailwind.config.js.bak

# 可再生的本地审查、包管理与门禁状态
.review-temp/
.pnpm-store/
.workbuddy/
.release-gate*.txt
/.vitest-attachments/

# 浏览器测试失败截图：可重复生成的本地产物，不作为功能代码提交
**/__tests__/__screenshots__/

# 远程附件缓存：工具运行期产物，可能包含用户本地文件
/.codex-remote-attachments/

# 本地工具索引与会话
.codegraph/
.superpowers/
.worktrees/
.runtime/
.vibe-owner.json

# Never publish internal agent instructions, local review output, or compiler state.
/AGENTS.md
/CONTEXT.md
/.agents/
/.claude/
/.codex/
/.superpowers/
/docs/superpowers/
/design-qa.md
/rule.md
/rule.lite.md
/output/
/public/screenshot/
/public/logos/
*.tsbuildinfo
